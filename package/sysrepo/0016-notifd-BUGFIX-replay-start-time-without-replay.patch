From 40a54fe8a08460018326c49b17f09e44765cc879 Mon Sep 17 00:00:00 2001
From: Roman Janota <Roman.Janota@cesnet.cz>
Date: Mon, 12 Oct 2026 10:11:32 +0200
Subject: [PATCH] notifd BUGFIX replay-start-time without replay

srsn_subscribe() returns the replay start of a stream whenever its
module has replay enabled, even when no replay was requested. A
subscription without configured-replay therefore reported a
replay-start-time, which ietf-subscribed-notifications only allows
with configured-replay. It is now asked for only when replay is.

Upstream: https://github.com/sysrepo/sysrepo/commit/c16ff58c86002cd45e791028d6ecf8927dfe5a04
Signed-off-by: Mattias Walström <lazzer@gmail.com>
---
 src/executables/sysrepo-notifd/notifd_control.c | 7 ++++---
 tests/notifd/test_notifd_lifecycle.c            | 7 +++++++
 2 files changed, 11 insertions(+), 3 deletions(-)

diff --git a/src/executables/sysrepo-notifd/notifd_control.c b/src/executables/sysrepo-notifd/notifd_control.c
index 8cba79e2..064c45ca 100644
--- a/src/executables/sysrepo-notifd/notifd_control.c
+++ b/src/executables/sysrepo-notifd/notifd_control.c
@@ -181,7 +181,8 @@ cleanup_unlock:
  *
  * @param[in] sess Session of the srsn subscriptions.
  * @param[in] p Parameters of the subscription.
- * @param[out] replay_start_time Actual replay start time of an event stream subscription.
+ * @param[out] replay_start_time Actual replay start time of an event stream subscription with replay, untouched
+ * otherwise.
  * @param[out] fd Notification pipe read end.
  * @param[out] srsn_sub_id srsn subscription ID.
  * @return ::SR_ERR_OK on success, error code on failure.
@@ -199,8 +200,8 @@ notifd_ctl_srsn_subscribe(sr_session_ctx_t *sess, const notif_srsn_params_t *p,
 
     switch (p->type) {
     case SRSN_SUB_NOTIF:
-        r = srsn_subscribe(sess, p->stream, p->xpath_filter, stop_time, start_time, 0, NULL, replay_start_time, fd,
-                srsn_sub_id);
+        r = srsn_subscribe(sess, p->stream, p->xpath_filter, stop_time, start_time, 0, NULL,
+                start_time ? replay_start_time : NULL, fd, srsn_sub_id);
         break;
     case SRSN_YANG_PUSH_PERIODIC:
         /* the period is in centiseconds */
diff --git a/tests/notifd/test_notifd_lifecycle.c b/tests/notifd/test_notifd_lifecycle.c
index fd43dbde..786bee8c 100644
--- a/tests/notifd/test_notifd_lifecycle.c
+++ b/tests/notifd/test_notifd_lifecycle.c
@@ -326,6 +326,13 @@ test_configured_replay(void **state)
     for (i = 0; i < 3; ++i) {
         lyd_free_all(notifs[i]);
     }
+
+    /* without configured-replay, there is no replay-start-time */
+    del_node(st, SUB_XP "/configured-replay", 93);
+    apply_changes(st);
+    notifs[0] = expect_notif(st, SUB_MODIFIED);
+    assert_no_notif_leaf(notifs[0], "replay-start-time");
+    lyd_free_all(notifs[0]);
 }
 
