From 0b4c51a03fd17ba918bed97494f29d91f03058b5 Mon Sep 17 00:00:00 2001
From: Roman Janota <Roman.Janota@cesnet.cz>
Date: Thu, 1 Oct 2026 17:42:01 +0200
Subject: [PATCH] notifd BUGFIX subscription id in event records

SRSN fills the id of the records it generates, such as replay-completed,
with its own process-local subscription ID, and the dispatch loop
delivered the frames unchanged, so the receivers were told about a
subscription they do not know.

The dispatch loop now sets the id of every ietf-subscribed-notifications
record to the configured subscription ID before delivering it.

Upstream: https://github.com/sysrepo/sysrepo/commit/c24346d0cb149d579dca713d6b00efb3e62bd239
Signed-off-by: Mattias Walström <lazzer@gmail.com>
---
 .../sysrepo-notifd/notifd_dispatch.c          | 33 +++++++++++++++++++
 tests/notifd/test_notifd_lifecycle.c          | 10 +++++-
 tests/notifd/tnotifd.h                        |  3 +-
 tests/notifd/tnotifd_udp.c                    |  6 +++-
 4 files changed, 49 insertions(+), 3 deletions(-)

diff --git a/src/executables/sysrepo-notifd/notifd_dispatch.c b/src/executables/sysrepo-notifd/notifd_dispatch.c
index 3715e5ba..ed461f04 100644
--- a/src/executables/sysrepo-notifd/notifd_dispatch.c
+++ b/src/executables/sysrepo-notifd/notifd_dispatch.c
@@ -458,6 +458,38 @@ notifd_disp_disconnect_ended(notifd_ctx_t *notifd_ctx)
     }
 }
 
+/**
+ * @brief Replace the SRSN subscription ID in a record generated by SRSN with the configured one.
+ *
+ * @param[in] notif Parsed notification.
+ * @param[in] sub_id Configured subscription ID.
+ */
+static void
+notifd_disp_record_id_replace(struct lyd_node *notif, uint32_t sub_id)
+{
+    struct lyd_node *id_node;
+    const char *mod_name;
+    char id_str[11];
+    LY_ERR lyrc;
+
+    /* only the records of this module carry the subscription ID, a notification of any other may have
+     * an unrelated "id" leaf */
+    mod_name = notif->schema->module->name;
+    if (strcmp(mod_name, "ietf-subscribed-notifications")) {
+        return;
+    }
+    if (lyd_find_path(notif, "id", 0, &id_node)) {
+        return;
+    }
+
+    sprintf(id_str, "%" PRIu32, sub_id);
+    lyrc = lyd_change_term(id_node, id_str);
+    if (lyrc && (lyrc != LY_EEXIST)) {
+        SRNTF_LOG_WRN("Failed to replace the ID of a \"%s\" record of subscription %" PRIu32 ".", LYD_NAME(notif),
+                sub_id);
+    }
+}
+
 /**
  * @brief Parse and deliver the drained frames and handle the ended subscriptions.
  *
@@ -511,6 +543,7 @@ notifd_disp_process(notifd_ctx_t *notifd_ctx)
             }
             ly_in_free(in, 0);
 
+            notifd_disp_record_id_replace(notif, receiver->sub->id);
             notifd_deliver_notif(notifd_ctx, receiver, notif, &disp->frames[i].timestamp);
             lyd_free_tree(notif);
         }
diff --git a/tests/notifd/test_notifd_lifecycle.c b/tests/notifd/test_notifd_lifecycle.c
index 49727345..b55833fe 100644
--- a/tests/notifd/test_notifd_lifecycle.c
+++ b/tests/notifd/test_notifd_lifecycle.c
@@ -296,6 +296,8 @@ static void
 test_configured_replay(void **state)
 {
     struct tnotifd_state *st = *state;
+    struct lyd_node *notifs[3];
+    int i;
 
     setup_sub(st, 93, "stream-xpath-filter", NCC, NULL);
     skip_notif(st, SUB_STARTED);
@@ -316,7 +318,13 @@ test_configured_replay(void **state)
     apply_changes(st);
 
     /* the daemon does not order these three relative to each other */
-    expect_notifs(st, (const char *[]) {SUB_MODIFIED, NCC, REPLAY_COMPLETED, NULL});
+    expect_notifs(st, (const char *[]) {SUB_MODIFIED, NCC, REPLAY_COMPLETED, NULL}, notifs);
+
+    /* the replay-completed record names the configured subscription */
+    assert_notif_leaf(notifs[2], "id", "93");
+    for (i = 0; i < 3; ++i) {
+        lyd_free_all(notifs[i]);
+    }
 }
 
 /**
diff --git a/tests/notifd/tnotifd.h b/tests/notifd/tnotifd.h
index 3c17da7c..c9b41686 100644
--- a/tests/notifd/tnotifd.h
+++ b/tests/notifd/tnotifd.h
@@ -505,8 +505,9 @@ void skip_notif(struct tnotifd_state *st, const char *path);
  *
  * @param[in] st Test state.
  * @param[in] paths NULL-terminated array of paths that must all arrive.
+ * @param[out] notifs Optional array of the received notifications, one for each of @p paths, caller must free.
  */
-void expect_notifs(struct tnotifd_state *st, const char **paths);
+void expect_notifs(struct tnotifd_state *st, const char **paths, struct lyd_node **notifs);
 
 /**
  * @brief Assert no notification with @p path arrives while the socket stays quiet.
diff --git a/tests/notifd/tnotifd_udp.c b/tests/notifd/tnotifd_udp.c
index c0debe91..a422bb43 100644
--- a/tests/notifd/tnotifd_udp.c
+++ b/tests/notifd/tnotifd_udp.c
@@ -598,7 +598,7 @@ skip_notif(struct tnotifd_state *st, const char *path)
 }
 
 void
-expect_notifs(struct tnotifd_state *st, const char **paths)
+expect_notifs(struct tnotifd_state *st, const char **paths, struct lyd_node **notifs)
 {
     struct lyd_node *notif = NULL;
     char *notif_path;
@@ -619,6 +619,10 @@ expect_notifs(struct tnotifd_state *st, const char **paths)
             if (!seen[i] && notif_path && !strcmp(paths[i], notif_path)) {
                 seen[i] = 1;
                 ++found;
+                if (notifs) {
+                    notifs[i] = notif;
+                    notif = NULL;
+                }
                 break;
             }
         }
