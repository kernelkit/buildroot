+static int
+sub_change_validate_selection_xpath(notifd_ctx_t *notifd_ctx, sr_session_ctx_t *session, sr_event_t event,
+        const char *xpath_filter)
+{
+    int rc = SR_ERR_OK;
+    const struct ly_ctx *ly_ctx;
+    struct ly_set *set = NULL;
