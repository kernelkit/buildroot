 src/sysrepo_types.h                           |  8 ++-
 4 files changed, 85 insertions(+), 6 deletions(-)
 rename modules/{sysrepo@2025-04-04.yang => sysrepo@2026-10-15.yang} (96%)

diff --git a/modules/sysrepo@2025-04-04.yang b/modules/sysrepo@2026-10-15.yang
similarity index 96%
rename from modules/sysrepo@2025-04-04.yang
rename to modules/sysrepo@2026-10-15.yang
index 75b58446..ba7e409c 100644
--- a/modules/sysrepo@2025-04-04.yang
+++ b/modules/sysrepo@2026-10-15.yang
@@ -27,6 +27,11 @@ module sysrepo {
     description
         "Sysrepo YANG datastore internal attributes and information.";
 
+    revision "2026-10-15" {
+        description
+            "Added last-modif annotation.";
+    }
+
     revision "2025-04-04" {
         description
             "Added schema mount extension instance metadata.";
@@ -74,6 +79,12 @@ module sysrepo {
             "RFC 6241 section 7.2.";
     }
 
+    md:annotation last-modif {
+        type yang:date-and-time;
+        description
+            "The timestamp of the last modification of the specific data node or any of its descendants.";
+    }
+
     identity notification {
         base ds:datastore;
         description
diff --git a/src/ly_wrap.c b/src/ly_wrap.c
index f0b6ace0..11abb7c8 100644
--- a/src/ly_wrap.c
+++ b/src/ly_wrap.c
@@ -259,7 +259,7 @@ sr_ly_ctx_new(struct ly_ctx **ly_ctx)
         sr_errinfo_new_ly(&err_info, SR_ERR_LY);
         goto cleanup;
     }
-    if (!ly_ctx_load_module(*ly_ctx, "sysrepo", "2025-04-04", NULL)) {
