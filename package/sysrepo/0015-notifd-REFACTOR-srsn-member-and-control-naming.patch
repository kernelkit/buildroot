From e4a3cf05888df94fd5615178ff0e072dda3299ae Mon Sep 17 00:00:00 2001
From: Roman Janota <Roman.Janota@cesnet.cz>
Date: Fri, 9 Oct 2026 11:51:49 +0200
Subject: [PATCH] notifd REFACTOR srsn member and control naming

The arguments of the srsn subscriptions of a configured subscription are
its srsn_params, the srsn subscription a receiver runs with them is now
its srsn instead of srsn_data.

Since the control thread exists, notif_receiver_srsn_start/stop() only
queue the work for it, so they are now notifd_control_srsn_start/stop(),
declared with the rest of the control thread interface.

Upstream: https://github.com/sysrepo/sysrepo/commit/bf64afbc007ec44d1f8bf2317c0a475bece671b4
Signed-off-by: Mattias Walström <lazzer@gmail.com>
---
 src/executables/sysrepo-notifd/main.c         |  4 +-
 src/executables/sysrepo-notifd/notifd.h       |  2 +-
 .../sysrepo-notifd/notifd_common.h            | 48 +++++++++----------
 .../sysrepo-notifd/notifd_config.c            | 12 ++---
 .../sysrepo-notifd/notifd_control.c           | 32 ++++++-------
 .../sysrepo-notifd/notifd_dispatch.c          |  2 +-
 .../sysrepo-notifd/notifd_runtime.c           | 10 ++--
 7 files changed, 55 insertions(+), 55 deletions(-)

diff --git a/src/executables/sysrepo-notifd/main.c b/src/executables/sysrepo-notifd/main.c
index 9879fdc5..9fc52dba 100644
--- a/src/executables/sysrepo-notifd/main.c
+++ b/src/executables/sysrepo-notifd/main.c
@@ -1020,9 +1020,9 @@ excluded_event_records_oper_get(sr_session_ctx_t *UNUSED(session), uint32_t UNUS
     /* the srsn subscriptions this receiver is done with kept their count in the base */
     excluded = recv->excluded_base;
 
-    if (recv->srsn_data.sub_id) {
+    if (recv->srsn.sub_id) {
         /* get the oper data from srsn sub */
-        if ((rc = srsn_oper_data_sub(recv->srsn_data.sub_id, &state_sub))) {
+        if ((rc = srsn_oper_data_sub(recv->srsn.sub_id, &state_sub))) {
             SRNTF_LOG_ERR("Failed to get subscription state for \"%s\" operational data request.", path);
             goto cleanup;
         }
diff --git a/src/executables/sysrepo-notifd/notifd.h b/src/executables/sysrepo-notifd/notifd.h
index 8a2d5a84..4264fb8d 100644
--- a/src/executables/sysrepo-notifd/notifd.h
+++ b/src/executables/sysrepo-notifd/notifd.h
@@ -389,7 +389,7 @@ struct notif_receiver_s {
         uint32_t sub_id;                        /**< srsn subscription ID, identifies the receiver's
                                                      notification pipe, which the dispatch loop owns */
         notif_srsn_start_t start;               /**< state of the start of a new srsn subscription */
-    } srsn_data;                                /**< srsn subscription data */
+    } srsn;                                     /**< srsn subscription of the receiver */
 
     notif_sub_t *sub;                           /**< back-pointer to the parent subscription */
     struct timespec last_reconnect_attempt;     /**< time of the last reconnect attempt */
diff --git a/src/executables/sysrepo-notifd/notifd_common.h b/src/executables/sysrepo-notifd/notifd_common.h
index 0d106723..fa7b5012 100644
--- a/src/executables/sysrepo-notifd/notifd_common.h
+++ b/src/executables/sysrepo-notifd/notifd_common.h
@@ -725,30 +725,6 @@ int notif_receiver_send(notifd_ctx_t *notifd_ctx, notif_receiver_t *receiver, co
  */
 int notifd_reconnect_due_receivers(notifd_ctx_t *notifd_ctx);
 
-/**
- * @brief Queue the start of the srsn subscription of a receiver.
- *
- * The control thread then connects an inactive receiver and sends it subscription-started, an active one is sent
- * subscription-modified instead, a failure invalidates the subscription.
- *
- * @warning The caller MUST hold the state write lock.
- *
- * @param[in] notifd_ctx Daemon context.
- * @param[in] receiver Receiver to start, any start queued or being executed before is discarded.
- */
-void notif_receiver_srsn_start(notifd_ctx_t *notifd_ctx, notif_receiver_t *receiver);
-
-/**
- * @brief Stop dispatching the srsn subscription of a receiver and queue its stop, a start queued or in progress is
- * discarded.
- *
- * @warning The caller MUST hold the state write lock.
- *
- * @param[in] notifd_ctx Daemon context.
- * @param[in] receiver Receiver to stop.
- */
-void notif_receiver_srsn_stop(notifd_ctx_t *notifd_ctx, notif_receiver_t *receiver);
-
 /*
  * ---------------------------------------------------------------------------
  * Control thread (notifd_control.c)
@@ -772,6 +748,30 @@ int notifd_control_start(notifd_ctx_t *notifd_ctx);
  */
 void notifd_control_stop(notifd_ctx_t *notifd_ctx);
 
+/**
+ * @brief Queue the start of the srsn subscription of a receiver.
+ *
+ * The control thread then connects an inactive receiver and sends it subscription-started, an active one is sent
+ * subscription-modified instead, a failure invalidates the subscription.
+ *
+ * @warning The caller MUST hold the state write lock.
+ *
+ * @param[in] notifd_ctx Daemon context.
+ * @param[in] receiver Receiver to start, any start queued or being executed before is discarded.
+ */
+void notifd_control_srsn_start(notifd_ctx_t *notifd_ctx, notif_receiver_t *receiver);
+
+/**
+ * @brief Stop dispatching the srsn subscription of a receiver and queue its stop, a start queued or in progress is
+ * discarded.
+ *
+ * @warning The caller MUST hold the state write lock.
+ *
+ * @param[in] notifd_ctx Daemon context.
+ * @param[in] receiver Receiver to stop.
+ */
+void notifd_control_srsn_stop(notifd_ctx_t *notifd_ctx, notif_receiver_t *receiver);
+
 /**
  * @brief Find the receiver of an SRSN subscription.
  *
diff --git a/src/executables/sysrepo-notifd/notifd_config.c b/src/executables/sysrepo-notifd/notifd_config.c
index 6397a45d..6851f6d6 100644
--- a/src/executables/sysrepo-notifd/notifd_config.c
+++ b/src/executables/sysrepo-notifd/notifd_config.c
@@ -1328,7 +1328,7 @@ subscription_receivers_disconnect(notifd_ctx_t *notifd_ctx, notif_sub_t *sub)
 
     LYA_FOR_EACH(sub->receivers, receiver) {
         /* disconnect the receiver */
-        notif_receiver_srsn_stop(notifd_ctx, receiver);
+        notifd_control_srsn_stop(notifd_ctx, receiver);
         notif_receiver_disconnect(receiver);
     }
 }
@@ -1500,7 +1500,7 @@ receiver_create_from_node(notifd_ctx_t *notifd_ctx, notif_sub_t *sub, const stru
     notif_receiver_resolve(receiver);
 
     /* the receiver is connected and sent subscription-started once its srsn subscription exists */
-    notif_receiver_srsn_start(notifd_ctx, receiver);
+    notifd_control_srsn_start(notifd_ctx, receiver);
 
 cleanup:
     if (rc) {
@@ -1518,7 +1518,7 @@ receiver_destroy(notifd_ctx_t *notifd_ctx, notif_sub_t *sub, notif_receiver_t *r
     }
 
     /* stop dispatch for this receiver */
-    notif_receiver_srsn_stop(notifd_ctx, receiver);
+    notifd_control_srsn_stop(notifd_ctx, receiver);
 
     /* disconnect the receiver */
     notif_receiver_disconnect(receiver);
@@ -1725,15 +1725,15 @@ process_modified_subscriptions(notifd_ctx_t *notifd_ctx)
                 /* stop the srsn subscriptions and start new ones with the new params */
                 (*sub)->state = NOTIF_SUB_STATE_VALID;
                 LYA_FOR_EACH((*sub)->receivers, receiver) {
-                    notif_receiver_srsn_stop(notifd_ctx, receiver);
-                    notif_receiver_srsn_start(notifd_ctx, receiver);
+                    notifd_control_srsn_stop(notifd_ctx, receiver);
+                    notifd_control_srsn_start(notifd_ctx, receiver);
                 }
                 resubscribed = 1;
             } else {
                 /* not resubscribed, the srsn subscriptions of the old target are not used anymore */
                 sub_invalidate(*sub, NULL);
                 LYA_FOR_EACH((*sub)->receivers, receiver) {
-                    notif_receiver_srsn_stop(notifd_ctx, receiver);
+                    notifd_control_srsn_stop(notifd_ctx, receiver);
                 }
             }
             (*sub)->resubscribe = 0;
diff --git a/src/executables/sysrepo-notifd/notifd_control.c b/src/executables/sysrepo-notifd/notifd_control.c
index 69c67fe5..8cba79e2 100644
--- a/src/executables/sysrepo-notifd/notifd_control.c
+++ b/src/executables/sysrepo-notifd/notifd_control.c
@@ -30,12 +30,12 @@
 #include <libyang/libyang.h>
 
 void
-notif_receiver_srsn_start(notifd_ctx_t *notifd_ctx, notif_receiver_t *receiver)
+notifd_control_srsn_start(notifd_ctx_t *notifd_ctx, notif_receiver_t *receiver)
 {
     notifd_control_t *ctl = &notifd_ctx->control;
 
     /* queue the start */
-    receiver->srsn_data.start = NOTIF_SRSN_START_QUEUED;
+    receiver->srsn.start = NOTIF_SRSN_START_QUEUED;
 
     /* CTL LOCK */
     pthread_mutex_lock(&ctl->lock);
@@ -48,40 +48,40 @@ notif_receiver_srsn_start(notifd_ctx_t *notifd_ctx, notif_receiver_t *receiver)
 }
 
 void
-notif_receiver_srsn_stop(notifd_ctx_t *notifd_ctx, notif_receiver_t *receiver)
+notifd_control_srsn_stop(notifd_ctx_t *notifd_ctx, notif_receiver_t *receiver)
 {
     notifd_control_t *ctl = &notifd_ctx->control;
     srsn_state_sub_t *state_sub = NULL;
     uint32_t *stop_id;
 
     /* cancel a queued or running start */
-    receiver->srsn_data.start = NOTIF_SRSN_START_NONE;
+    receiver->srsn.start = NOTIF_SRSN_START_NONE;
 
-    if (!receiver->srsn_data.sub_id) {
+    if (!receiver->srsn.sub_id) {
         return;
     }
 
     /* carry the excluded count over, the next srsn subscription starts counting from zero */
-    if (!srsn_oper_data_sub(receiver->srsn_data.sub_id, &state_sub)) {
+    if (!srsn_oper_data_sub(receiver->srsn.sub_id, &state_sub)) {
         receiver->excluded_base += state_sub->excluded_count;
         srsn_oper_data_subscriptions_free(state_sub, SRSN_FREE_SINGLE);
     }
 
     /* stop dispatching at once, nothing of the old subscription may be delivered from now on */
-    notifd_dispatch_detach(&notifd_ctx->dispatch, receiver->srsn_data.sub_id);
+    notifd_dispatch_detach(&notifd_ctx->dispatch, receiver->srsn.sub_id);
 
     /* CTL LOCK */
     pthread_mutex_lock(&ctl->lock);
 
     LYA_ADD_ITEM(ctl->stop_ids, stop_id, ERRMEM; goto cleanup_unlock);
-    *stop_id = receiver->srsn_data.sub_id;
+    *stop_id = receiver->srsn.sub_id;
     pthread_cond_signal(&ctl->cond);
 
 cleanup_unlock:
     /* CTL UNLOCK */
     pthread_mutex_unlock(&ctl->lock);
 
-    receiver->srsn_data.sub_id = 0;
+    receiver->srsn.sub_id = 0;
 }
 
 /**
@@ -104,7 +104,7 @@ notifd_ctl_start_fail(notifd_ctx_t *notifd_ctx, notif_sub_t *sub)
 
     /* the srsn subscriptions of the other receivers are not used either */
     LYA_FOR_EACH(sub->receivers, receiver) {
-        notif_receiver_srsn_stop(notifd_ctx, receiver);
+        notifd_control_srsn_stop(notifd_ctx, receiver);
     }
 }
 
@@ -139,7 +139,7 @@ notifd_ctl_start_take(notifd_ctx_t *notifd_ctx, notif_srsn_params_t *params)
 
     LYA_FOR_EACH(notifd_ctx->subs, sub) {
         LYA_FOR_EACH((*sub)->receivers, receiver) {
-            if (receiver->srsn_data.start != NOTIF_SRSN_START_QUEUED) {
+            if (receiver->srsn.start != NOTIF_SRSN_START_QUEUED) {
                 continue;
             }
 
@@ -163,7 +163,7 @@ notifd_ctl_start_take(notifd_ctx_t *notifd_ctx, notif_srsn_params_t *params)
                 break;
             }
 
-            receiver->srsn_data.start = NOTIF_SRSN_START_STARTING;
+            receiver->srsn.start = NOTIF_SRSN_START_STARTING;
             taken = 1;
             goto cleanup_unlock;
         }
@@ -231,7 +231,7 @@ notifd_ctl_starting_find(notifd_ctx_t *notifd_ctx)
 
     LYA_FOR_EACH(notifd_ctx->subs, sub) {
         LYA_FOR_EACH((*sub)->receivers, receiver) {
-            if (receiver->srsn_data.start == NOTIF_SRSN_START_STARTING) {
+            if (receiver->srsn.start == NOTIF_SRSN_START_STARTING) {
                 return receiver;
             }
         }
@@ -265,7 +265,7 @@ notifd_ctl_start(notifd_ctx_t *notifd_ctx, const notif_srsn_params_t *params)
         /* deleted, stopped or started again while being started */
         goto cleanup_unlock;
     }
-    receiver->srsn_data.start = NOTIF_SRSN_START_NONE;
+    receiver->srsn.start = NOTIF_SRSN_START_NONE;
     sub = receiver->sub;
 
     if (r) {
@@ -275,7 +275,7 @@ notifd_ctl_start(notifd_ctx_t *notifd_ctx, const notif_srsn_params_t *params)
         goto cleanup_unlock;
     }
 
-    receiver->srsn_data.sub_id = srsn_sub_id;
+    receiver->srsn.sub_id = srsn_sub_id;
     sub->replay_start_time = replay_start_time;
 
     if ((receiver->state != NOTIF_RECV_STATE_ACTIVE) && receiver->addr_len && (sub->state == NOTIF_SUB_STATE_VALID)) {
@@ -299,7 +299,7 @@ notifd_ctl_start(notifd_ctx_t *notifd_ctx, const notif_srsn_params_t *params)
     if (notifd_dispatch_add(&notifd_ctx->dispatch, fd, srsn_sub_id)) {
         SRNTF_LOG_ERR("Failed to add notification dispatch for subscription ID %" PRIu32 " and receiver \"%s\".",
                 sub->id, receiver->name);
-        receiver->srsn_data.sub_id = 0;
+        receiver->srsn.sub_id = 0;
         notifd_ctl_start_fail(notifd_ctx, sub);
         goto cleanup_unlock;
     }
diff --git a/src/executables/sysrepo-notifd/notifd_dispatch.c b/src/executables/sysrepo-notifd/notifd_dispatch.c
index c5720f3c..1eef7a03 100644
--- a/src/executables/sysrepo-notifd/notifd_dispatch.c
+++ b/src/executables/sysrepo-notifd/notifd_dispatch.c
@@ -449,7 +449,7 @@ notifd_disp_disconnect_ended(notifd_ctx_t *notifd_ctx)
         SRNTF_LOG_INF("Notification subscription of receiver \"%s\" was terminated by the publisher.",
                 receiver->name);
 
-        notif_receiver_srsn_stop(notifd_ctx, receiver);
+        notifd_control_srsn_stop(notifd_ctx, receiver);
         receiver->state = NOTIF_RECV_STATE_DISCONNECTED;
     }
 }
diff --git a/src/executables/sysrepo-notifd/notifd_runtime.c b/src/executables/sysrepo-notifd/notifd_runtime.c
index f5732400..30bf5633 100644
--- a/src/executables/sysrepo-notifd/notifd_runtime.c
+++ b/src/executables/sysrepo-notifd/notifd_runtime.c
@@ -522,12 +522,12 @@ notif_receiver_sync_on_start(notif_receiver_t *receiver)
 {
     notif_sub_t *sub = receiver->sub;
 
-    if ((sub->srsn_params.type != SRSN_YANG_PUSH_ON_CHANGE) || !sub->sync_on_start || !receiver->srsn_data.sub_id) {
+    if ((sub->srsn_params.type != SRSN_YANG_PUSH_ON_CHANGE) || !sub->sync_on_start || !receiver->srsn.sub_id) {
         return;
     }
 
     /* sent asynchronously by the srsn subscription */
-    if (srsn_yang_push_on_change_resync(receiver->srsn_data.sub_id)) {
+    if (srsn_yang_push_on_change_resync(receiver->srsn.sub_id)) {
         SRNTF_LOG_WRN("Failed to resync receiver \"%s\" of subscription %" PRIu32 ".", receiver->name, sub->id);
     }
 }
@@ -550,7 +550,7 @@ notif_receiver_backoff_reconnect(notifd_ctx_t *notifd_ctx, notif_receiver_t *rec
         return SR_ERR_OK;
     }
 
-    if (!receiver->srsn_data.sub_id) {
+    if (!receiver->srsn.sub_id) {
         /* "active" means the receiver is being sent every applicable notification, which is false
          * without a notification pipe, so do not reconnect it at all */
         return SR_ERR_OPERATION_FAILED;
@@ -637,7 +637,7 @@ notifd_reconnect_due_receivers(notifd_ctx_t *notifd_ctx)
             receiver = &notifd_ctx->subs[i]->receivers[j];
 
             /* skip the receivers that are connected or cannot be reconnected */
-            if (!receiver->inst || !receiver->srsn_data.sub_id || notif_receiver_is_connected(receiver)) {
+            if (!receiver->inst || !receiver->srsn.sub_id || notif_receiver_is_connected(receiver)) {
                 continue;
             }
             assert((receiver->state == NOTIF_RECV_STATE_DISCONNECTED) ||
@@ -855,7 +855,7 @@ receiver_find_by_srsn_sub_id(notifd_ctx_t *notifd_ctx, uint32_t srsn_sub_id)
 
     LYA_FOR(notifd_ctx->subs, i) {
         LYA_FOR(notifd_ctx->subs[i]->receivers, j) {
-            if (notifd_ctx->subs[i]->receivers[j].srsn_data.sub_id == srsn_sub_id) {
+            if (notifd_ctx->subs[i]->receivers[j].srsn.sub_id == srsn_sub_id) {
                 return &notifd_ctx->subs[i]->receivers[j];
             }
         }
