-    while (src_child) {
-        if ((err_info = sr_lyd_dup(src_child, NULL, options, 0, &trg_child))) {
-            return err_info;
-        }
-
-        if ((err_info = sr_lyd_insert_child(trg_parent, trg_child))) {
